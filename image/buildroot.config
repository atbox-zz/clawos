# image/buildroot.config
# G-05: Buildroot 2024.11 configuration for ClawOS minimal rootfs
# Target: < 128MB ISO (Gate P4 requirement)
# Build: cd buildroot-2024.11 && make BR2_DEFCONFIG=../image/buildroot.config

# ── Architecture ─────────────────────────────────────────────
BR2_x86_64=y
BR2_x86_64_v3=y                          # AVX2 support for vector ops
BR2_TOOLCHAIN_BUILDROOT_MUSL=y           # musl libc (A-04)
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# FIX D-01: kernel is 6.6.72 — tell buildroot internal toolchain the
# actual headers version so check-kernel-headers.sh passes.
BR2_TOOLCHAIN_HEADERS_AT_LEAST="6.6"

# ── Target image ─────────────────────────────────────────────
BR2_TARGET_GENERIC_HOSTNAME="clawos"
BR2_TARGET_GENERIC_ISSUE="ClawOS v0.1.0 — AI-Native OS"
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="96M"        # rootfs < 96MB (leaves room for ISO overhead)
BR2_TARGET_ROOTFS_SQUASHFS=y            # squashfs for read-only root
BR2_TARGET_ROOTFS_SQUASHFS_COMP_METHOD_ZSTD=y

# ── Kernel ────────────────────────────────────────────────────
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.72"
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(TOPDIR)/../kernel/clawos-kernel.config"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# ── Bootloader ────────────────────────────────────────────────
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_TARGET_GRUB2_I386_PC=y              # BIOS boot support (needed for ISO hybrid)
# genimage — produces the actual .iso from bzImage + rootfs + grub
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(TOPDIR)/../image/post-image.sh"
BR2_PACKAGE_HOST_GENIMAGE=y

# ── System ────────────────────────────────────────────────────
BR2_INIT_SYSTEMD=y
BR2_TARGET_GENERIC_PASSWD_SHA512=y
BR2_ROOTFS_OVERLAY="$(TOPDIR)/../image/rootfs-overlay"

# ── Essential packages only (minimize image size) ────────────

# Security tools (required)
BR2_PACKAGE_LIBSECCOMP=y
BR2_PACKAGE_APPARMOR=y
BR2_PACKAGE_KEYUTILS=y                   # keyctl for Secrets Vault
BR2_PACKAGE_IPROUTE2=y                   # ip netns (C-07)
BR2_PACKAGE_IPTABLES=y                   # netns filtering (C-07)

# eBPF tools
BR2_PACKAGE_BCC=n                        # Too large — use bpftool only
BR2_PACKAGE_BPFTOOL=y
BR2_PACKAGE_LIBBPF=y

# TLS
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y

# Debugging (dev builds only — strip in release)
BR2_PACKAGE_STRACE=y                     # C-02: strace for syscall analysis
BR2_PACKAGE_GDB=n                        # Too large
BR2_PACKAGE_HTOP=y                       # Minimal monitoring

# Filesystem utils
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_SQLITE=y                     # ClawFS backend

# Python3 (for migration scripts P3.3)
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PY_LAUNCHER=y
BR2_PACKAGE_PYTHON_PSYCOPG2=n           # Not needed post-migration

# ── Explicitly EXCLUDED (keeps image small) ───────────────────
BR2_PACKAGE_DOCKER_ENGINE=n             # Replaced by namespaces (C-04)
BR2_PACKAGE_POSTGRESQL=n                # Replaced by ClawFS/SQLite (E-02)
BR2_PACKAGE_NGINX=n                     # Web gateway is built-in axum
BR2_PACKAGE_NODEJS=n
BR2_PACKAGE_RUBY=n
BR2_PACKAGE_PERL=n
BR2_PACKAGE_GTK3=n                      # No GUI

# ── Post-build scripts ────────────────────────────────────────
BR2_ROOTFS_POST_BUILD_SCRIPT="$(TOPDIR)/../image/post-build.sh"
