// crates/clawos-ebpf-userspace/src/main.rs
//
// eBPF userspace daemon - B-05, B-06
// Loads eBPF programs into kernel, reads Ring Buffer events,
// runs anomaly scoring, emits Prometheus metrics, broadcasts
// security alerts via IPC to clawos-agent.

#![allow(dead_code)]
// 1. 確保匯入了 Ebpf 和 Btf
#[cfg(feature = "ebpf-embed")]
use aya::{Ebpf, EbpfLoader, programs::{Lsm, TracePoint} }; 
use anyhow::{Result, Context}; 

// 2. 確保 Result 有匯入
//#[cfg(feature = "ebpf-embed")]
use aya::maps::RingBuf;
//#[cfg(feature = "ebpf-embed")]
use aya_log::EbpfLogger;
use serde_json::json;
use std::{sync::Arc, time::Duration};
use tokio::{io::AsyncWriteExt, net::UnixStream, sync::Mutex};
//use tracing::{info,warn};
use tracing::{debug, error, info};

mod anomaly;
use anomaly::AnomalyEngine;
mod metrics;

#[repr(C)]
#[derive(Debug, Clone, Copy)]
struct ClawOsEvent {
    kind: u32,
    severity: u8,
    _pad: [u8; 3],
    pid: u32,
    tgid: u32,
    uid: u32,
    gid: u32,
    ppid: u32,
    _pad2: u32,
    timestamp_ns: u64,
    syscall_nr: u64,
    syscall_arg0: u64,
    comm: [u8; 16],
    details: [u8; 176],
}

const EVENT_SIZE: usize = 256;

#[tokio::main]
async fn main() -> Result<()> {
    tracing_subscriber::fmt()
        .with_env_filter("clawos_ebpf=info,warn")
        .json()
        .init();

    info!("ClawOS eBPF daemon starting");

    #[cfg(feature = "ebpf-embed")]
    {
      //let ebpf_bytes = include_bytes!("/home/user/fixed410/target/bpfel-unknown-none/release/clawos-ebpf");
        let ebpf_bytes = include_bytes!("../../../target/bpfel-unknown-none/release/clawos-ebpf");
        info!("EBPF bytes length: {}", ebpf_bytes.len());

      //let mut bpf = EbpfLoader::new() .btf(aya::Btf::from_sys_fs().ok().as_ref()) .load(ebpf_bytes) .context("Failed to load eBPF object")?;
        let mut bpf = aya::Ebpf::load(ebpf_bytes) 
              .context("Failed to load eBPF object")?;

        EbpfLogger::init(&mut bpf).ok();

        attach_tracepoint(&mut bpf, "clawos_execve", "syscalls", "sys_enter_execve")?;
        attach_tracepoint(&mut bpf, "clawos_openat", "syscalls", "sys_enter_openat")?;
        attach_lsm(&mut bpf, "clawos_lsm_file_open", "file_open")?;
        attach_lsm(&mut bpf, "clawos_lsm_socket_connect", "socket_connect")?;

        info!("eBPF programs loaded and attached");

        let metrics = Arc::new(Mutex::new(metrics::ClawOsMetrics::new()));
        let metrics_clone = Arc::clone(&metrics);
        tokio::spawn(async move { metrics::serve_prometheus("127.0.0.1:9090", metrics_clone).await });

        let mut anomaly = AnomalyEngine::new();

        let pid = std::process::id();
        tokio::fs::create_dir_all("/var/run/clawos").await.ok();
        tokio::fs::write("/var/run/clawos/ebpf.pid", pid.to_string())
            .await
            .ok();
        info!(pid, "PID file written");

        let mut ring_buf: RingBuf<_> = bpf
            .take_map("EVENTS")
            .context("EVENTS map not found")?
            .try_into()
            .context("Failed to open ring buffer")?;

        info!("Reading eBPF ring buffer...");

        loop {
            while let Some(item) = ring_buf.next() {
                if item.len() < EVENT_SIZE {
                    continue;
                }

                let evt = unsafe { *(item.as_ptr() as *const ClawOsEvent) };
                drop(item);

                let kind = evt.kind;
                let severity = evt.severity;
                let pid = evt.pid;
                let comm = cstr(&evt.comm);
                let details = cstr(&evt.details);

                debug!(kind, severity, pid, comm, details, "eBPF event");

                metrics.lock().await.record_event(kind, severity);

                if let Some(alert) = anomaly.score(&evt) {
                    error!(
                        kind = kind,
                        severity = severity,
                        pid = pid,
                        comm = comm,
                        score = alert.score,
                        "ANOMALY DETECTED"
                    );
                    send_security_alert(&alert).await.ok();
                }
            }

            tokio::time::sleep(Duration::from_millis(10)).await;
        }
    }

    #[cfg(not(feature = "ebpf-embed"))]
    {
        warn!("eBPF bytecode not embedded - running in stub mode.");
        warn!("Run 'cargo build-ebpf' then rebuild with --features ebpf-embed");

        let metrics = Arc::new(Mutex::new(metrics::ClawOsMetrics::new()));
        let metrics_clone = Arc::clone(&metrics);
        tokio::spawn(async move { metrics::serve_prometheus("127.0.0.1:9090", metrics_clone).await });

        let pid = std::process::id();
        tokio::fs::create_dir_all("/var/run/clawos").await.ok();
        tokio::fs::write("/var/run/clawos/ebpf.pid", pid.to_string())
            .await
            .ok();
        info!(pid, "PID file written");
        info!("Running in stub mode - metrics server only");

        loop {
            tokio::time::sleep(Duration::from_secs(60)).await;
        }
    }
}

#[cfg(feature = "ebpf-embed")]
fn attach_tracepoint(bpf: &mut Ebpf, prog: &str, category: &str, name: &str) -> Result<()> {
    let program: &mut TracePoint = bpf
        .program_mut(prog)
        .with_context(|| format!("eBPF program '{}' not found", prog))?
        .try_into()?;
    program.load()?;
    program.attach(category, name)?;
    info!(program = prog, "Tracepoint attached: {}/{}", category, name);
    Ok(())
}

use aya::Btf; // 確保頂部有這行
/*
#[cfg(feature = "ebpf-embed")]
fn attach_lsm(bpf: &mut Ebpf, prog: &str, hook: &str) -> Result<()> {
    let program: &mut Lsm = bpf.program_mut(prog)
        .with_context(|| format!("LSM program '{}' not found", prog))?
        .try_into()?;
    program.load(hook, bpf.ok_or_else(|| anyhow::anyhow!("BTF not found"))?)?;
    info!(program = prog, hook, "LSM hook attached");
    Ok(())
}
*/
fn attach_lsm(bpf: &mut Ebpf, prog: &str, hook: &str) -> Result<()> {
    let program: &mut Lsm = bpf.program_mut(prog).unwrap().try_into()?;
    
    // 手動從系統加載 BTF 並傳入
    let btf = Btf::from_sys_fs()?;
    program.load(hook, &btf)?;

    program.attach()?;
    Ok(())
}

fn cstr(bytes: &[u8]) -> String {
    let end = bytes.iter().position(|&b| b == 0).unwrap_or(bytes.len());
    String::from_utf8_lossy(&bytes[..end]).to_string()
}

async fn send_security_alert(alert: &anomaly::Alert) -> Result<()> {
    let ipc_path = "/var/run/clawos/ipc/agent.sock";
    let mut stream = UnixStream::connect(ipc_path)
        .await
        .context("Cannot connect to agent IPC socket")?;

    let msg = json!({
        "id": uuid::Uuid::new_v4().to_string(),
        "version": 1,
        "type": "security.alert",
        "from": "clawos-ebpf",
        "to": "clawos-agent",
        "timestamp": chrono::Utc::now().timestamp_millis(),
        "payload": {
            "event_kind": alert.kind_name,
            "severity": alert.severity_name,
            "pid": alert.pid,
            "details": alert.details,
            "score": alert.score,
            "action_taken": alert.action_taken
        }
    });

    stream.write_all(format!("{}\n", msg).as_bytes()).await?;
    Ok(())
}
