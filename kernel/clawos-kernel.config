# ClawOS Linux 6.6 LTS — Hardened Kernel Configuration
# Task A-01, A-02, A-03
# Generate final .config: scripts/kernel-config.sh
#
# Apply with: scripts/apply-kernel-config.sh /path/to/linux-6.6

# ── eBPF (required for B-01 ~ B-07) ────────────────────────────
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y       # No BPF interpreter, JIT only (security)
CONFIG_BPF_LSM=y                  # eBPF LSM hooks (F-03)
CONFIG_DEBUG_INFO_BTF=y           # CO-RE support (B-07)
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_BPF_EVENTS=y
CONFIG_FTRACE=y                   # Required by some BPF progs

# ── Namespaces (required for C-03, C-04) ───────────────────────
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y                  # C-03: user namespace
CONFIG_PID_NS=y                   # C-04: PID namespace
CONFIG_NET_NS=y                   # C-07: network namespace
CONFIG_SYSVIPC=n                  # Disable legacy SysV IPC

# ── cgroup v2 (required for C-06) ──────────────────────────────
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y              # pids.max (fork bomb protection)
CONFIG_CGROUP_RDMA=n
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=n
CONFIG_MEMCG=y                    # memory.max
CONFIG_MEMCG_SWAP=n               # no swap ever
CONFIG_BLK_CGROUP=y               # io.max
CONFIG_CGROUP_BPF=y               # eBPF programs can attach to cgroups
CONFIG_CGROUP2_DEBUG=n

# ── seccomp (required for C-01) ────────────────────────────────
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ── LSM stack ──────────────────────────────────────────────────
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y        # F-01: AppArmor
CONFIG_SECURITY_APPARMOR_INTROSPECT_POLICY=y
CONFIG_SECURITY_YAMA=y            # Prevent ptrace across process trees
CONFIG_SECURITY_LANDLOCK=y        # Additional path-based sandboxing
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_SECURITY_LOCKDOWN_LSM=y    # A-06: Lockdown mode
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LSM="lockdown,yama,landlock,apparmor,bpf"

# ── KASLR & memory hardening (A-02) ────────────────────────────
CONFIG_RANDOMIZE_BASE=y           # KASLR
CONFIG_RANDOMIZE_MEMORY=y         # ASLR for physical memory map
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y               # Virtually mapped stacks (overflow detection)
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y # Zero newly allocated pages
CONFIG_INIT_ON_FREE_DEFAULT_ON=y  # Zero freed pages
CONFIG_PAGE_TABLE_ISOLATION=y     # Meltdown mitigation
CONFIG_RETPOLINE=y                # Spectre v2 mitigation

# ── Slab hardening ──────────────────────────────────────────────
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y

# ── GCC plugins ─────────────────────────────────────────────────
CONFIG_GCC_PLUGINS=y
CONFIG_GCC_PLUGIN_STACKLEAK=y     # Erase kernel stack on syscall return
CONFIG_GCC_PLUGIN_RANDSTRUCT=y    # Randomize kernel struct layouts
CONFIG_GCC_PLUGIN_STRUCTLEAK=y
CONFIG_GCC_PLUGIN_STRUCTLEAK_BYREF_ALL=y

# ── Module signing (A-05) ───────────────────────────────────────
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y         # Reject unsigned modules
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_SIG_KEY="certs/clawos-module-signing.pem"

# ── Disabled attack surfaces ────────────────────────────────────
CONFIG_KEXEC=n                    # No kernel replacement at runtime
CONFIG_KEXEC_FILE=n
CONFIG_HIBERNATION=n              # No suspend-to-disk (secrets in RAM)
CONFIG_PROC_KCORE=n               # No /proc/kcore
CONFIG_DEVKMEM=n                  # No /dev/kmem
CONFIG_PROC_PAGE_MONITOR=n
CONFIG_FTRACE_SYSCALLS=n          # Disable after eBPF is operational
CONFIG_KPROBES=y                  # Required for eBPF kprobes (B-02)
CONFIG_UPROBE_EVENTS=y

# ── Network hardening ───────────────────────────────────────────
CONFIG_NET_INGRESS=y              # XDP/TC ingress (B-04)
CONFIG_XDP_SOCKETS=y
CONFIG_NETFILTER=y
CONFIG_IP_NF_IPTABLES=y           # For C-07 network namespace rules
CONFIG_SYN_COOKIES=y
CONFIG_IP_ADVANCED_ROUTER=n
CONFIG_IPV6=n                     # Disable IPv6 — ClawOS is IPv4-only

# ── Device hardening ────────────────────────────────────────────
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_DEVTMPFS_SAFE=y            # Only create needed devices

# ── Crypto (for ClawFS AES-256-GCM) ────────────────────────────
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_KEYS=y                     # kernel keyring for Secrets Vault
CONFIG_PERSISTENT_KEYRINGS=y
CONFIG_KEY_DH_OPERATIONS=y

# ── Filesystem ──────────────────────────────────────────────────
CONFIG_EXT4_FS=y                  # Default rootfs
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=n
CONFIG_FUSE_FS=n                  # No FUSE
CONFIG_OVERLAY_FS=n               # No overlayfs (we use pivot_root)
